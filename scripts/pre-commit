#!/bin/bash
# Pre-commit hook: enforce code quality and prevent local-only file commits.
# Installed by scripts/setup.sh into <git-common-dir>/hooks.
#
# Lints the staged source files with LINT_CMD from .claude/project.env (skipped
# when empty). Typecheck and tests run in scripts/verify.sh, which scripts/pre-push
# requires before a push, so a commit never waits on the gate lock.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
[ -f .claude/project.env ] && . .claude/project.env

# --- Block local-only paths (customize for your repo) ---

BLOCKED_PATHS="docs/plans/ docs/scratch/"

for path in $BLOCKED_PATHS; do
  # Only block additions/modifications, not deletions (allow removing tracked files)
  STAGED=$(git diff --cached --diff-filter=d --name-only -- "$path")
  if [ -n "$STAGED" ]; then
    echo "ERROR: Attempting to commit files under '$path' which is local-only."
    echo "Blocked files:"
    echo "$STAGED" | sed 's/^/  /'
    echo ""
    echo "These files should not be committed to the repository."
    echo "Run 'git reset HEAD -- $path' to unstage them."
    exit 1
  fi
done

# --- No em or en dash on added lines (skipped mid-merge: the other side's lines are not this commit's) ---

if [ -x scripts/check-dashes.sh ] && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  scripts/check-dashes.sh --cached
fi

# --- Code quality checks ---

EXT_RE=$(printf '%s' "${SOURCE_EXTENSIONS:-}" | tr -s ' ' '|')
STAGED_SOURCE=""
if [ -n "$EXT_RE" ]; then
  STAGED_SOURCE=$(git diff --cached --diff-filter=d --name-only | grep -E "\.($EXT_RE)$" || true)
fi

if [ -n "${LINT_CMD:-}" ] && [ -n "$STAGED_SOURCE" ]; then
  echo "Running lint: $LINT_CMD"
  if ! printf '%s\n' "$STAGED_SOURCE" | tr '\n' '\0' | xargs -0 sh -c "$LINT_CMD \"\$@\"" _; then
    echo ""
    echo "ERROR: Lint failed on staged files."
    exit 1
  fi
fi

echo "All pre-commit checks passed."
