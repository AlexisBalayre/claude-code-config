# Project profile: the one place stack-specific commands and patterns live.
# Sourced by .claude/hooks/*.sh, scripts/worktree-*.sh and scripts/pre-commit.
# Filled by /adapt-to-project. An empty value turns off the check that uses it,
# so the template runs harmlessly before it is adapted.
# TODO(adapt): fill every key for this project, then delete this line.

# Source file extensions (space-separated, no dot) that trigger the Stop hooks.
SOURCE_EXTENSIONS="ts tsx js jsx mjs cjs py go rs java kt rb php cs swift"

# Run by quality-checks.sh on every Stop. FORMAT_FIX_CMD and LINT_CMD get the
# dirty source files appended as arguments; TYPECHECK_CMD runs on the whole repo.
# Examples: "npx biome check --write" | "ruff format" | "gofmt -w" | "cargo fmt --"
FORMAT_FIX_CMD=""
# Examples: "npx biome check" | "ruff check" | "npx eslint"
LINT_CMD=""
# Examples: "npx tsc -b" | "mypy ." | "go vet ./..." | "cargo check"
TYPECHECK_CMD=""

# Run by scripts/pre-commit (not on Stop: suites are too slow for every turn).
# Examples: "pnpm test" | "pytest" | "go test ./..." | "cargo test"
TEST_CMD=""

# Run by scripts/worktree-create.sh in a fresh worktree.
# Examples: "pnpm install" | "uv sync" | "go mod download" | "bundle install"
INSTALL_CMD=""

# protect-generated.sh blocks Edit/Write on paths matching this ERE.
# Example: '(\.gen\.ts$|/generated/|_pb2\.py$|\.pb\.go$)'
GENERATED_PATHS_REGEX=""

# validate-file-naming.sh: new files whose path matches FILE_NAMING_SCOPE_REGEX
# must have a basename matching FILE_NAMING_REGEX; FILE_NAMING_HINT is shown on a block.
# Example scope: '^src/.*\.py$'  name: '^[a-z0-9_]+\.py$'  hint: 'snake_case module names'
FILE_NAMING_SCOPE_REGEX=""
FILE_NAMING_REGEX=""
FILE_NAMING_HINT=""

# Git worktree workflow (scripts/worktree-*.sh, .claude/hooks/git-safety.sh).
GIT_TRUNK=main
WORKTREE_BRANCH_PREFIX=feature
