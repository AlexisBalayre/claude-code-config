{
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh",
    "padding": 0
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Agent(*)",
      "Bash(scripts/worktree-create.sh *)",
      "Bash(scripts/worktree-remove.sh *)",
      "Bash(bash scripts/verify.sh)",
      "Bash(scripts/verify.sh)",
      "Bash(bash scripts/gate-lock.sh *)",
      "Bash(scripts/gate-lock.sh *)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git worktree*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git mv*)",
      "Bash(git remote*)",
      "Bash(git check-ignore*)",
      "Bash(git -C*)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(gh pr *)",
      "Bash(gh api*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git -C * clean -f*)",
      "Bash(rm -rf *)",
      "Read(.env*)",
      "Read(secrets.env*)",
      "Read(secrets.*.env)",
      "Read(**/credentials*)",
      "Read(**/.aws/credentials)",
      "Edit(~/.claude/settings*.json)",
      "Edit(//**/.claude/settings*.json)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git branch -D*)",
      "Bash(git -C * branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git -c *)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git pull*--upload-pack*)",
      "Bash(git fetch*--upload-pack*)",
      "Bash(git grep*-O*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr *://*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-checks.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/convention-spot-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/comment-pruner.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-safety.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-gate.sh",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frozen-paths.sh",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-file-naming.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tool-result-size.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-compact-state.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
